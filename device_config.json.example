{
    "app_environment": "local",
    "app_version": "0.3.0",
    "mqtt_enabled": true,
    "mqtt_broker": "localhost",
    "mqtt_client_id": "microweaver",
    "mqtt_port": 1883,
    "mqtt_topic_pub": "devices/{mqtt_username}/data",
    "mqtt_topic_sub": "devices/{mqtt_username}/command",
    "mqtt_topic_status": "devices/{mqtt_username}/state",
    "unified_mqtt_contract_enabled": false,
    "mqtt_username": "",
    "mqtt_password": "",
    "wifi_ssid": "",
    "wifi_password": "",
    "wifi_ip": "",
    "wifi_subnet": "",
    "wifi_gateway": "",
    "wifi_dns": "",
    "wifi_disable_power_save": false,
    "wifi_connect_timeout_seconds": 20,
    "wifi_reconnect_delay_seconds": 2,
    "wifi_max_reconnect_delay_seconds": 30,
    "mqtt_reconnect_delay_seconds": 2,
    "mqtt_max_reconnect_delay_seconds": 30,
    "mqtt_keepalive_seconds": 300,
    "mqtt_ssl": false,
    "mqtt_ssl_cert_path": "",
    "mqtt_ssl_key_path": "",
    "ntp_enabled": true,
    "ntp_host": "pool.ntp.org",
    "ntp_sync_attempts": 3,
    "ntp_retry_delay_seconds": 1,
    "mqtt_lwt_topic": "devices/{mqtt_username}/availability",
    "mqtt_lwt_message": "{\"state\":\"offline\"}",
    "mqtt_lwt_retain": true,
    "mqtt_lwt_qos": 0,
    "mqtt_publish_retain": false,
    "mqtt_publish_qos": 0,
    "state_report_interval_seconds": 60,
    "mqtt_rejection_retry_seconds": 300,
    "publish_interval_seconds": 1,
    "watchdog_enabled": false,
    "watchdog_timeout_ms": 8000,
    "boot_loop_protection_enabled": false,
    "boot_loop_max_attempts": 5,
    "boot_loop_state_path": "boot_state.json",
    "boot_interrupt_window_seconds": 2,
    "autostart_enabled": true,
    "safe_mode_sleep_seconds": 5,
    "memory_monitor_enabled": false,
    "memory_monitor_threshold_bytes": 10000,
    "memory_monitor_action": "log",
    "health_check_enabled": false,
    "health_check_interval_seconds": 30,
    "health_report_enabled": false,
    "health_report_interval_seconds": 60,
    "health_report_topic": "device/microweaver/health",
    "service_restart_enabled": false,
    "service_restart_max_attempts": 3,
    "log_format": "json",
    "log_level": "info",
    "log_level_override_enabled": false,
    "log_level_topic": "device/microweaver/log-level",
    "crash_log_enabled": false,
    "crash_log_path": "crash.json",
    "crash_log_max_bytes": 4096,
    "dht_enabled": false,
    "dht_sensor_type": "dht22",
    "dht_pin": 4,
    "dht_temperature_topic_suffix": "temperature",
    "dht_humidity_topic_suffix": "humidity",
    "relay_enabled": true,
    "relay_pin": 5,
    "relay_topic_suffix": "relay",
    "rgb_enabled": false,
    "rgb_mode": "controllable",
    "rgb_red_pin": 25,
    "rgb_green_pin": 26,
    "rgb_blue_pin": 27,
    "rgb_topic_suffix": "rgb",
    "oled_enabled": false,
    "oled_sda_pin": 21,
    "oled_scl_pin": 22,
    "oled_i2c_addr": 60,
    "oled_width": 128,
    "oled_height": 64,
    "oled_topic_suffix": "oled",
    "potentiometer_enabled": false,
    "potentiometer_pin": 33,
    "potentiometer_topic_suffix": "potentiometer",
    "rotary_angle_enabled": false,
    "rotary_angle_pin": 34,
    "rotary_angle_topic_suffix": "rotary_angle",
    "provisioning_ap_ssid": "Microweaver-Setup",
    "provisioning_ap_password": "",
    "provisioning_ap_ip": "192.168.4.1",
    "provisioning_port": 80,
    "provisioning_led_enabled": false,
    "provisioning_led_pin": 2,
    "factory_reset_enabled": false,
    "factory_reset_pin": -1,
    "factory_reset_hold_seconds": 3,
    "factory_reset_sentinel_path": "reprovision.flag",
    "claim_enabled": false,
    "claim_url": "",
    "claim_code": "",
    "device_id": "",
    "device_cert": "",
    "device_key": "",
    "device_cert_path": "device_cert.pem",
    "device_key_path": "device_key.pem",
    "ota_enabled": false,
    "ota_manifest_url": "",
    "ota_state_path": "ota_state.json",
    "ota_topic": "ota/update",
    "ota_status_topic": "ota/status",
    "device_name": "",
    "timezone": "UTC",
    "timezone_offset_minutes": 0,
    "lcd_enabled": false,
    "lcd_i2c_id": 0,
    "lcd_sda_pin": 22,
    "lcd_scl_pin": 21,
    "lcd_i2c_addr": 62,
    "lcd_rgb_addr": 98,
    "lcd_cols": 16,
    "lcd_rows": 2,
    "servo_enabled": false,
    "servo_pin": 13,
    "servo_default_angle": 90,
    "pir_enabled": false,
    "pir_pin": 34,
    "pir_warmup_seconds": 10,
    "fan_enabled": false,
    "fan_in1_pin": 2,
    "fan_in2_pin": 4,
    "outdoor_light_enabled": false,
    "outdoor_light_pin": 17,
    "buzzer_enabled": false,
    "buzzer_pin": 19,
    "co_sensor_enabled": false,
    "co_sensor_pin": 35,
    "co_sensor_threshold": 50,
    "co_sensor_heartbeat_seconds": 30,
    "gas_sensor_enabled": false,
    "gas_sensor_pin": 32,
    "gas_sensor_threshold": 50,
    "gas_sensor_heartbeat_seconds": 30
}

{
    "app_environment": "local",
    "mqtt_broker": "localhost",
    "mqtt_client_id": "microweaver",
    "mqtt_port": 1883,
    "mqtt_topic_pub": "command/control/room/light",
    "mqtt_topic_sub": "data/sensor/room/temperature",
    "mqtt_username": "",
    "mqtt_password": "",
    "wifi_ssid": "",
    "wifi_password": "",
    "wifi_connect_timeout_seconds": 20,
    "mqtt_reconnect_delay_seconds": 2,
    "mqtt_max_reconnect_delay_seconds": 30,
    "mqtt_keepalive_seconds": 300,
    "watchdog_enabled": false,
    "watchdog_timeout_ms": 8000,
    "boot_loop_protection_enabled": false,
    "boot_loop_max_attempts": 5,
    "boot_loop_state_path": "boot_state.json",
    "safe_mode_sleep_seconds": 5,
    "memory_monitor_enabled": false,
    "memory_monitor_threshold_bytes": 10000,
    "memory_monitor_action": "log",
    "health_check_enabled": false,
    "health_check_interval_seconds": 30,
    "service_restart_enabled": false,
    "service_restart_max_attempts": 3
}
